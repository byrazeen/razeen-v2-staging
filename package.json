{
  "name": "razeen-v2-staging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:guard": "node tests/build-guard.mjs && node tests/guard.negative.mjs",
    "test:mutation": "node tests/build-guard.mjs && node tests/mutation-proof.mjs",
    "test": "npm run test:guard && npm run test:mutation && npm run test:injection && npm run test:env && npm run test:secrets",
    "test:injection": "node tests/build-guard.mjs && node tests/injection-proof.mjs",
    "test:env": "node tests/staging-env.test.mjs",
    "test:secrets": "node tests/secret-scan.mjs && node tests/prod-reference-scan.mjs",
    "test:rls": "node tests/rls.test.mjs",
    "test:rls:mutation": "node tests/rls-mutation-proof.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.22.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
