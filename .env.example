# RAZEEN V2 STAGING — انسخه إلى .env.local واملأه بقيم staging فقط.
# ⚠️ لا تضع أي قيمة إنتاج هنا. الحارس يوقف التطبيق إن اكتشفها.

VITE_APP_ENV=staging

# مشروع Supabase الخاص بـstaging — يجب ألا يكون bpdqgiytpmiagbzplrhz
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# الخدمات الخارجية: mock | sandbox | disabled  ("live" مرفوض في staging)
VITE_PAYMENT_MODE=mock
VITE_MESSAGING_MODE=mock
VITE_EMAIL_MODE=disabled
VITE_SHIPPING_MODE=mock
VITE_ANALYTICS_MODE=disabled
